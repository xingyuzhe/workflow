{
  "name": "workflow-contract",
  "version": 1,
  "artifacts": [
    {
      "id": "proposal",
      "kind": "document",
      "path": "proposal.md",
      "required": true,
      "requires": [],
      "template": "templates/proposal.md",
      "instruction": "Define motivation, scoped changes, exact capability names, impact, and non-goals."
    },
    {
      "id": "specs",
      "kind": "capability-deltas",
      "path": "specs/",
      "publishPath": ".workflow/specs",
      "required": false,
      "requires": ["proposal"],
      "template": "templates/spec.md",
      "instruction": "Create complete specs/<capability>/{spec.md,design.md} pairs with verifiable requirements and module ownership."
    },
    {
      "id": "design",
      "kind": "document",
      "path": "design.md",
      "required": true,
      "requires": ["proposal"],
      "template": "templates/design.md",
      "instruction": "Record cross-cutting context, goals, non-goals, decisions, and trade-offs."
    },
    {
      "id": "tasks",
      "kind": "task-list",
      "path": "tasks.md",
      "required": true,
      "requires": ["proposal", "design"],
      "template": "templates/tasks.md",
      "instruction": "Create an ordered checklist using exactly '- [ ] X.Y description'."
    }
  ]
}
